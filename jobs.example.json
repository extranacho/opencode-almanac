{
  "version": 1,
  "jobs": [
    {
      "id": "monthly-report",
      "label": "Monthly report",
      "day": 1,
      "hour": 8,
      "catchUp": "3d",
      "agent": "build",
      "promptFile": "prompts/monthly.md"
    },
    {
      "id": "sf-standup-notes",
      "label": "Monday notes for the SF team",
      "every": "week",
      "weekday": "mon",
      "hour": 8,
      "minute": 30,
      "timezone": "America/Los_Angeles",
      "prompt": "Summarise last week's platform work for the SF team."
    },
    {
      "id": "morning-digest",
      "label": "Morning digest",
      "every": "day",
      "hour": 7,
      "minute": 30,
      "catchUp": "4h",
      "prompt": "Summarise yesterday's commits and open PRs."
    },
    {
      "id": "inbox-sweep",
      "label": "Inbox sweep",
      "every": "hour",
      "minute": 15,
      "prompt": "Triage anything new in TODO.md."
    }
  ]
}
